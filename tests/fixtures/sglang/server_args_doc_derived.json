{
  "_note": [
    "SGLang parameter schema, DOC/SOURCE-DERIVED rather than introspected.",
    "Field names verified 2026-09-14 against sgl-project/sglang @ main:",
    "  python/sglang/srt/arg_groups/fields/schedule.py  -> mem_fraction_static, max_total_tokens,",
    "     max_running_requests, max_queued_requests, chunked_prefill_size, max_prefill_tokens, page_size",
    "  python/sglang/srt/arg_groups/fields/parallel.py  -> tp_size, dp_size, pp_size, ep_size",
    "  python/sglang/srt/arg_groups/fields/model.py     -> context_length, kv_cache_dtype",
    "  python/sglang/srt/arg_groups/fields/memory.py    -> disable_radix_cache",
    "Defaults come from the official server-arguments documentation.",
    "This fixture exists so adapter logic is testable without SGLang installed; the adapter",
    "itself introspects the real ServerArgs at runtime and must be re-verified against a live",
    "install. Note SGLang moved its whole argument surface into arg_groups/fields/* modules,",
    "which is precisely why a hardcoded flag table is not viable."
  ],
  "sglang_version": "doc-derived",
  "cli_flags": {
    "mem_fraction_static": ["--mem-fraction-static"],
    "max_total_tokens": ["--max-total-tokens"],
    "max_running_requests": ["--max-running-requests"],
    "max_queued_requests": ["--max-queued-requests"],
    "chunked_prefill_size": ["--chunked-prefill-size"],
    "max_prefill_tokens": ["--max-prefill-tokens"],
    "context_length": ["--context-length"],
    "page_size": ["--page-size"],
    "tp_size": ["--tp-size", "--tp"],
    "dp_size": ["--dp-size", "--dp"],
    "pp_size": ["--pp-size"],
    "ep_size": ["--ep-size", "--ep"],
    "kv_cache_dtype": ["--kv-cache-dtype"],
    "dtype": ["--dtype"],
    "quantization": ["--quantization"],
    "disable_radix_cache": ["--disable-radix-cache"],
    "disable_cuda_graph": ["--disable-cuda-graph"],
    "cuda_graph_max_bs": ["--cuda-graph-max-bs"],
    "attention_backend": ["--attention-backend"],
    "schedule_policy": ["--schedule-policy"],
    "schedule_conservativeness": ["--schedule-conservativeness"],
    "enable_dp_attention": ["--enable-dp-attention"],
    "enable_mixed_chunk": ["--enable-mixed-chunk"],
    "disable_overlap_schedule": ["--disable-overlap-schedule"],
    "host": ["--host"],
    "port": ["--port"],
    "model_path": ["--model-path"],
    "served_model_name": ["--served-model-name"],
    "trust_remote_code": ["--trust-remote-code"]
  },
  "fields": {
    "mem_fraction_static": { "type": "float", "default": null },
    "max_total_tokens": { "type": "int", "default": null },
    "max_running_requests": { "type": "int", "default": null },
    "max_queued_requests": { "type": "int", "default": null },
    "chunked_prefill_size": { "type": "int", "default": null },
    "max_prefill_tokens": { "type": "int", "default": 16384 },
    "context_length": { "type": "int", "default": null },
    "page_size": { "type": "int", "default": 1 },
    "tp_size": { "type": "int", "default": 1 },
    "dp_size": { "type": "int", "default": 1 },
    "pp_size": { "type": "int", "default": 1 },
    "ep_size": { "type": "int", "default": 1 },
    "kv_cache_dtype": { "type": "str", "default": "auto" },
    "dtype": { "type": "str", "default": "auto" },
    "quantization": { "type": "str", "default": null },
    "disable_radix_cache": { "type": "bool", "default": false },
    "disable_cuda_graph": { "type": "bool", "default": false },
    "cuda_graph_max_bs": { "type": "int", "default": null },
    "attention_backend": { "type": "str", "default": null },
    "schedule_policy": { "type": "str", "default": "fcfs" },
    "schedule_conservativeness": { "type": "float", "default": 1.0 },
    "enable_dp_attention": { "type": "bool", "default": false },
    "enable_mixed_chunk": { "type": "bool", "default": false },
    "disable_overlap_schedule": { "type": "bool", "default": false },
    "model_path": { "type": "str", "default": null }
  },
  "choices": {
    "kv_cache_dtype": ["auto", "fp8_e4m3", "fp8_e5m2"],
    "dtype": ["auto", "bfloat16", "float16", "float32", "half"],
    "schedule_policy": ["fcfs", "lof", "lpm", "random"],
    "attention_backend": ["fa3", "flashinfer", "torch_native", "triton"]
  }
}
